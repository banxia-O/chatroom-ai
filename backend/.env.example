# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info

# JWT 签名密钥（≥64 字符）。生成：openssl rand -hex 48
JWT_SECRET=please-replace-with-a-random-string-of-at-least-64-characters-long

# JWT 过期时间（jsonwebtoken 格式，如 "7d" "12h"）
JWT_EXPIRES_IN=7d

# SQLite 文件路径
DB_PATH=./data/chatroom.db

# bcrypt 轮数
BCRYPT_ROUNDS=12

# 房间默认与上限
DEFAULT_MAX_MEMBERS=20
ROOM_FAIL_THRESHOLD=5
ROOM_LOCK_MINUTES=30

# CORS（多个用逗号分隔；留空表示同源）
CORS_ORIGIN=

# 限流（每分钟）
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_SEND_PER_10S=10
